# Docker / Server
APP_PORT=8085

# API — use a URL the browser can reach (public IP/host when deploying with Docker).
VITE_API_BASE_URL=http://localhost:3002/v1

# File microservice (file_uploader). No trailing slash.
# - `pnpm dev`: baked into the app; browser calls this URL directly.
# - Docker: same value in .env → nginx reads it at container start and proxies /files/... to it.
VITE_FILE_SERVICE_URL=http://localhost:3085
VITE_FILE_SERVICE_API_KEY=ontor-project-key-123

VITE_API_LOG_REQUESTS=true

# Firebase (FCM)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
