# Docker / Server
# Port exposed on the host when running with docker-compose (default: 3000)
APP_PORT=8085

# API Configuration
VITE_API_BASE_URL=http://localhost:3002/v1
# Base URL for documents and profile pictures (API returns path; prepended for full URL)
VITE_DOCUMENT_BASE_URL=http://116.68.207.105:8085

# File upload service (multipart POST /files/upload). No trailing slash.
VITE_FILE_UPLOAD_URL=http://116.68.207.105:3085
# Sent as `x-api-key` (required; use ontor-project-key-123 for this app unless backend says otherwise)
VITE_FILE_UPLOAD_API_KEY=ontor-project-key-123

# API Request Logging
# Set to true to enable console logging of all API requests and responses
VITE_API_LOG_REQUESTS=true

# Firebase (FCM push notifications for web)
# From Firebase Console: Project settings > General > Your apps > Web app config
# Leave empty to disable FCM.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# From Firebase Console: Project settings > Cloud Messaging > Web Push certificates (Key pair)
VITE_FIREBASE_VAPID_KEY=

